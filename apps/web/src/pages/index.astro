---
import DuwopBoot from '../components/DuwopBoot.astro';
import '../styles/fonts.css';
import '../lib/duwop.css';
import '../lib/command-center.css';
import '../lib/gods.css';
import '../lib/aphrodite.css';
import '../lib/event-horizon-azure.css';
import '../styles/d1.css';
import '../styles/theme-picker.css';
import '../styles/shell.css';
import '../styles/panel.css';
import '../styles/projects.css';
import '../styles/artifact.css';
import '../styles/code-colours.css';
import '../styles/builder-look.css';
import '../styles/black-hole.css';
import shell from '../shell.html?raw';
import hole from '../black-hole.html?raw';
// List 29: the shell is static markup, inlined here (as phone.astro does); shell-start.ts runs its DOM code once. No React.
const markup = shell.replace('<!--black-hole-->', hole);
---
<!doctype html>
<html lang="en" class="dark" data-theme="event-horizon-prime" data-amoled data-fx="underglow motion shine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <DuwopBoot />
    <title>P9 — Event Horizon</title>
  </head>
  <body>
    <div data-p9-island><Fragment set:html={markup} /></div>
    <script>
      import { startShell } from '../shell-start';
      startShell();
    </script>
  </body>
</html>

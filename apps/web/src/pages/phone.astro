---
// The desktop's look (c18): DUWOP's boot script and theme packs, so the picked theme paints on the first frame.
import DuwopBoot from '../components/DuwopBoot.astro';
import '../styles/fonts.css';
import '../lib/duwop.css';
import '../lib/command-center.css';
import '../lib/gods.css';
import '../lib/aphrodite.css';
import '../styles/theme-picker.css';
import '../styles/phone.css';
import '../styles/artifact.css';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#080b10" />
    <DuwopBoot />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/p9-icon.png" />
    <link rel="apple-touch-icon" href="/p9-icon.png" />
    <title>P9 phone</title>
  </head>
  <body data-view="chat">
    <div class="fx-ambient"><div class="fx-horizon"></div></div>
    <!-- L2, P4: a small P9 black hole bobbing inside a turning arc from first paint until the chat list has loaded, so the page never looks frozen. -->
    <div id="boot" role="status" aria-label="Loading"><img src="/p9-icon.png" alt="" width="96" height="96" /></div>
    <div id="app">
    <div id="stale" role="status" hidden>Offline: showing stale data</div>
    <div id="gap" role="alert" hidden>History gap. Tap to reload.</div>
    <main>
      <section data-view="chat">
        <header class="bar" data-bar="chat"></header>
        <div id="chatList" class="scroll" aria-label="Chats"></div>
        <div id="chatArea" hidden>
          <div id="chips" class="chips" hidden></div>
          <div class="scrollwrap">
            <div class="scroll" id="chatBody">
              <select id="conversation" hidden aria-label="Conversation"></select>
              <div id="pinned" hidden></div>
              <button type="button" id="earlier" hidden>Load earlier</button>
              <div id="events" aria-live="polite"></div>
            </div>
            <button type="button" id="jump" aria-label="Jump to the latest message" hidden></button>
          </div>
        </div>
        <!-- COMPOSER SLOT (c2 builds the composer here): sits below the chat scroller, never scrolls away, rides the keyboard. Keep it one flex child; the queued list and the form are today's composer. -->
        <div id="composerSlot" hidden>
          <div id="queued" class="stack" aria-live="polite" hidden></div>
          <!-- P18: sending while the agent works, as the desktop's Steer / Queue chip and its Ctrl Enter interrupt. -->
          <div id="midTurn" role="group" aria-label="Send while the agent works" hidden><span id="midTurnLabel">Claude is working</span><button type="submit" form="composer" data-when="steer" title="Send into this turn when its current step ends">Steer</button><button type="submit" form="composer" class="quiet" data-when="queue" title="Send when this turn ends">Queue</button><button type="submit" form="composer" class="quiet" data-when="now" title="Stop this turn and send this now">Interrupt</button></div>
          <div id="box">
            <div id="attached" class="attached" hidden></div>
            <div id="slash" class="slash" role="listbox" aria-label="Slash commands" hidden></div>
            <form id="composer"><textarea id="prompt" rows="1" aria-label="Message" placeholder="Message Claude"></textarea><p id="composerNote" class="muted" role="status" hidden></p><button type="submit" id="send"><span class="vh">Send message</span></button></form>
            <button type="button" id="attach" class="quiet" aria-label="Attach images" aria-haspopup="dialog">+</button>
            <button type="button" id="modePill" class="quiet" aria-haspopup="dialog">Mode ▾</button>
            <input type="file" id="attachInput" multiple hidden>
            <span id="modeHome" hidden><select id="mode" aria-label="Mode"></select><select id="model" aria-label="Model" hidden></select><span id="more"><span id="pickers"></span></span></span>
          </div>
        </div>
      </section>
      <section data-view="terminal" hidden>
        <header class="bar" data-bar="terminal"></header>
        <select id="terminal" aria-label="Terminal" hidden></select>
        <div id="screen" aria-label="Terminal"></div>
        <div id="keys" class="keys"><button data-key="esc">Esc</button><button data-key="tab">Tab</button><button data-key="ctrlc">Ctrl+C</button><button data-key="up" aria-label="Up arrow">↑</button><button data-key="down" aria-label="Down arrow">↓</button><button data-key="left" aria-label="Left arrow">←</button><button data-key="right" aria-label="Right arrow">→</button><button data-key="paste">Paste</button></div>
      </section>
      <section data-view="mission" hidden>
        <header class="bar" data-bar="mission"></header>
        <div id="mission" class="stack"></div>
      </section>
      <section data-view="usage" hidden>
        <header class="bar" data-bar="usage"></header>
        <div id="signIn" class="stack"></div>
        <div id="usage" class="stack"></div>
      </section>
      <section data-view="files" hidden>
        <header class="bar" data-bar="files"></header>
        <div id="browser"><ul id="fileList" class="list"></ul></div>
        <div id="fileView" hidden>
          <div id="conflict" class="conflict" role="alert" hidden><span>Changed on disk after you opened it. Your draft is kept and not saved.</span><button id="loadDisk" class="quiet">Load disk version</button><button id="saveMine" class="quiet">Save mine</button></div>
          <div id="rendered" class="md" hidden></div>
          <div id="editor" aria-label="File contents"></div>
        </div>
      </section>
    </main>
    <dialog id="looseDlg" class="loose" aria-labelledby="looseT" aria-describedby="looseP"><form method="dialog">
      <h2 id="looseT"></h2><p id="looseP"></p><p class="note">The agent lock in the desktop's Settings still overrides it. Mode changes back at any time.</p>
      <div class="stack"><button class="danger" value="yes">Turn on</button><button class="quiet" value="never">Turn on, don't show again</button><button class="quiet" value="no" autofocus>Cancel</button></div>
    </form></dialog>
    <nav aria-label="Phone workspace">
      <button data-nav="chat" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/></svg>Chat</button>
      <button data-nav="terminal"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m7 10 3 2-3 2M12 15h4"/></svg>Terminal</button>
      <button data-nav="mission"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h7v7H4zM13 5h7v4h-7zM13 12h7v7h-7zM4 15h7v4H4z"/></svg>Mission</button>
      <button data-nav="usage"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V11M12 20V4M19 20v-6"/></svg>Usage</button>
      <button data-nav="files"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Files</button>
    </nav>
    </div>
    <dialog id="sheet" class="sheet"><div class="grab" aria-hidden="true"></div><h2 id="sheetTitle"></h2><div id="sheetBody"></div></dialog>
    <script src="../phone.ts"></script>
  </body>
</html>

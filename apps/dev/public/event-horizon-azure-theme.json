  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#75839A" } },
    { "scope": ["punctuation", "meta.brace", "keyword.operator", "storage.type.function.arrow"], "settings": { "foreground": "#A4B1C6" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#B77AFF" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#42C7F5" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace", "meta.type.annotation entity.name.type"], "settings": { "foreground": "#7EA9F8" } },
    { "scope": ["string", "punctuation.definition.string", "string.template", "constant.numeric", "constant.character"], "settings": { "foreground": "#F6BB58" } },
    { "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined", "constant.language"], "settings": { "foreground": "#63D9BD" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#D7AF77" } },
    { "scope": ["variable", "variable.parameter", "variable.other", "variable.other.property", "meta.object-literal.key", "support.variable.property", "meta.definition.property"], "settings": { "foreground": "#DCE5F1" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "punctuation.definition.decorator", "entity.name.function.decorator", "meta.function.decorator"], "settings": { "foreground": "#7EA9F8" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F17F94" } },

    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#42C7F5" } },
    { "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css", "meta.selector.css"], "settings": { "foreground": "#B77AFF" } },
    { "scope": ["support.type.property-name.css"], "settings": { "foreground": "#42C7F5" } },
    { "scope": ["support.constant.property-value.css", "meta.property-value.css", "constant.other.color.rgb-value.css"], "settings": { "foreground": "#F6BB58" } },
    { "scope": ["variable.css", "variable.argument.css"], "settings": { "foreground": "#7EA9F8" } },
    { "scope": ["entity.name.command.shell", "support.function.builtin.shell"], "settings": { "foreground": "#42C7F5" } },
    { "scope": ["constant.other.option"], "settings": { "foreground": "#7EA9F8" } },

    { "scope": ["text.html.markdown", "meta.paragraph.markdown"], "settings": { "foreground": "#DCE5F1" } },
    { "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#B77AFF", "fontStyle": "bold" } },
    { "scope": ["punctuation.definition.heading.markdown"], "settings": { "foreground": "#B77AFF", "fontStyle": "" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#DCE5F1", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#DCE5F1", "fontStyle": "italic" } },
    { "scope": ["markup.strikethrough"], "settings": { "foreground": "#A4B1C6", "fontStyle": "strikethrough" } },
    { "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"], "settings": { "foreground": "#8A63D6" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#A4B1C6" } },
    { "scope": ["punctuation.definition.quote.begin.markdown", "beginning.punctuation.definition.quote.markdown"], "settings": { "foreground": "#8A63D6" } },
    { "scope": ["string.other.link.title.markdown", "string.other.link.description.markdown", "meta.link.inline.markdown string.other.link.title.markdown"], "settings": { "foreground": "#42C7F5" } },
    { "scope": ["markup.underline.link", "markup.underline.link.markdown"], "settings": { "foreground": "#7EA9F8" } },
    { "scope": ["markup.inline.raw.string.markdown", "markup.inline.raw"], "settings": { "foreground": "#F6BB58" } },
    { "scope": ["punctuation.definition.markdown"], "settings": { "foreground": "#8A63D6" } },
    { "scope": ["punctuation.definition.raw.markdown"], "settings": { "foreground": "#F6BB58" } },
    { "scope": ["fenced_code.block.language", "fenced_code.block.language.markdown", "fenced_code.block.language.attributes.markdown"], "settings": { "foreground": "#7EA9F8" } },
    { "scope": ["markup.fenced_code.block.markdown"], "settings": { "foreground": "#DCE5F1" } },
    { "scope": ["meta.separator.markdown"], "settings": { "foreground": "#8A63D6" } },
    { "scope": ["punctuation.definition.table.markdown", "punctuation.separator.table.markdown"], "settings": { "foreground": "#75839A" } },
    { "scope": ["constant.character.escape.markdown"], "settings": { "foreground": "#A4B1C6" } },
    { "scope": ["text.html.markdown entity.name.tag", "text.html.markdown punctuation.definition.tag"], "settings": { "foreground": "#7EA9F8" } },
    { "scope": ["text.html.markdown entity.other.attribute-name"], "settings": { "foreground": "#42C7F5" } }
  ],
  "semanticTokenColors": {
    "keyword": "#B77AFF",
    "function": "#42C7F5",
    "method": "#42C7F5",
    "class": "#7EA9F8",
    "interface": "#7EA9F8",
    "type": "#7EA9F8",
    "typeParameter": "#7EA9F8",
    "enum": "#7EA9F8",
    "namespace": "#7EA9F8",
    "decorator": "#7EA9F8",
    "string": "#F6BB58",
    "number": "#F6BB58",
    "regexp": "#D7AF77",
    "comment": "#75839A",
    "variable": "#DCE5F1",
    "parameter": "#DCE5F1",
    "property": "#DCE5F1",
    "enumMember": "#DCE5F1",
    "operator": "#A4B1C6",
    "variable.defaultLibrary": "#DCE5F1",
    "class.defaultLibrary": "#7EA9F8"
  }
}

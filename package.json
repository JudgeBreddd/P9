{
  "name": "p9",
  "version": "0.1.9-beta.8",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "bin": {
    "p9": "scripts/p9.mjs"
  },
  "main": "apps/desktop/start.cjs",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "test": "node scripts/with-tmp.mjs node --test test/*.test.mjs",
    "test:capped": "node scripts/mem-guard.mjs && systemd-run --user --scope -q --unit=eh-tests-$$ -p MemoryMax=3G -p MemorySwapMax=0 node scripts/with-tmp.mjs node --test --test-concurrency=4 test/*.test.mjs",
    "gate:3": "node scripts/with-tmp.mjs node scripts/gate.mjs",
    "gate:all": "node scripts/with-tmp.mjs node scripts/gate.mjs --all",
    "scan": "node scripts/scan.mjs",
    "start": "node apps/server/main.mjs",
    "teh": "node scripts/teh.mjs",
    "build": "astro build --root apps/web && node scripts/frame-runtimes.mjs && vite build --config apps/dev/vite.config.mjs",
    "check": "astro check --root apps/web",
    "desktop": "env -u ELECTRON_RUN_AS_NODE electron apps/desktop/start.cjs",
    "gate:4": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase4",
    "gate:5": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase5",
    "gate:6": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase6",
    "gate:7": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase7",
    "gate:8": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase8",
    "gate:9": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase9",
    "gate:10": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase10",
    "gate:11": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase11",
    "gate:12": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase12",
    "gate:13": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase13",
    "gate:15": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase15",
    "gate:16": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase16",
    "gate:17": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase17",
    "build:dev": "vite build --config apps/dev/vite.config.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:win": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.106.0",
    "@agentclientprotocol/codex-acp": "2.6.0",
    "@agentclientprotocol/sdk": "2.6.0",
    "@hono/node-server": "2.1.7",
    "@simplewebauthn/server": "14.1.0",
    "electron-updater": "6.8.11",
    "hono": "4.13.18",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.8",
    "@codemirror/legacy-modes": "6.5.5",
    "@codingame/monaco-vscode-api": "39.0.4",
    "@codingame/monaco-vscode-authentication-service-override": "39.0.4",
    "@codingame/monaco-vscode-configuration-service-override": "39.0.4",
    "@codingame/monaco-vscode-css-default-extension": "39.0.4",
    "@codingame/monaco-vscode-debug-service-override": "39.0.4",
    "@codingame/monaco-vscode-editor-api": "39.0.4",
    "@codingame/monaco-vscode-explorer-service-override": "39.0.4",
    "@codingame/monaco-vscode-extension-gallery-service-override": "39.0.4",
    "@codingame/monaco-vscode-extensions-service-override": "39.0.4",
    "@codingame/monaco-vscode-files-service-override": "39.0.4",
    "@codingame/monaco-vscode-json-default-extension": "39.0.4",
    "@codingame/monaco-vscode-keybindings-service-override": "39.0.4",
    "@codingame/monaco-vscode-languages-service-override": "39.0.4",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "39.0.4",
    "@codingame/monaco-vscode-model-service-override": "39.0.4",
    "@codingame/monaco-vscode-notifications-service-override": "39.0.4",
    "@codingame/monaco-vscode-output-service-override": "39.0.4",
    "@codingame/monaco-vscode-python-default-extension": "39.0.4",
    "@codingame/monaco-vscode-remote-agent-service-override": "39.0.4",
    "@codingame/monaco-vscode-scm-service-override": "39.0.4",
    "@codingame/monaco-vscode-search-service-override": "39.0.4",
    "@codingame/monaco-vscode-shellscript-default-extension": "39.0.4",
    "@codingame/monaco-vscode-storage-service-override": "39.0.4",
    "@codingame/monaco-vscode-task-service-override": "39.0.4",
    "@codingame/monaco-vscode-terminal-service-override": "39.0.4",
    "@codingame/monaco-vscode-testing-service-override": "39.0.4",
    "@codingame/monaco-vscode-textmate-service-override": "39.0.4",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "39.0.4",
    "@codingame/monaco-vscode-theme-service-override": "39.0.4",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "39.0.4",
    "@codingame/monaco-vscode-workbench-service-override": "39.0.4",
    "@codingame/monaco-vscode-working-copy-service-override": "39.0.4",
    "@codingame/monaco-vscode-workspace-trust-service-override": "39.0.4",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "1.5.6",
    "@lezer/json": "1.0.3",
    "@lezer/markdown": "1.8.1",
    "@lezer/python": "1.1.19",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xterm/xterm": "6.1.0-beta.337",
    "astro": "7.4.11",
    "codemirror": "6.0.2",
    "electron": "45.3.0",
    "marked": "18.2.0",
    "mermaid": "12.3.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@39.0.4"
  },
  "build": {
    "appId": "com.judgebreddd.p9",
    "productName": "P9 Event Horizon",
    "icon": "docs/brand/icon-primary-1024.png",
    "directories": {
      "output": "dist/windows"
    },
    "asarUnpack": [
      "apps/desktop/pets/**"
    ],
    "files": [
      "apps/desktop/**",
    "!apps/desktop/**/*.md",
      "apps/web/dist/**",
      "apps/dev/dist/**",
      "apps/server/child-env.mjs",
      "apps/server/anymouse.mjs",
      "packages/protocol/**",
      "scripts/teh.mjs",
      "apps/server/process-tree.mjs",
      "apps/server/windows.mjs",
      "apps/server/deps.mjs",
      "apps/server/update.mjs",
      "apps/server/pieces.mjs",
      "package.json",
      "!node_modules/@openai/**",
      "!node_modules/@anthropic-ai/**",
      "!node_modules/@agentclientprotocol/**"
    ],
    "extraResources": [
      {
        "from": ".build/licenses",
        "to": "licenses"
      },
      {
        "from": "packages",
        "to": "daemon/packages"
      },
      {
        "from": "scripts/windows-host.ps1",
        "to": "daemon/scripts/windows-host.ps1"
      },
      {
        "from": "scripts/install-windows.ps1",
        "to": "daemon/scripts/install-windows.ps1"
      },
      {
        "from": ".build/daemon-extra",
        "to": "daemon"
      },
      {
        "from": ".build/daemon-extra/node_modules",
        "to": "daemon/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "p9-event-horizon-${version}-windows-${arch}.${ext}",
      "extraResources": [
        {
          "from": ".build/node-win/node.exe",
          "to": "daemon/node.exe"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "p9-event-horizon",
      "category": "Development",
      "artifactName": "p9-event-horizon-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": ".build/node-linux/bin/node",
          "to": "daemon/node"
        },
        {
          "from": ".build/editor/reh.tar.gz",
          "to": "editor/reh.tar.gz"
        },
        {
          "from": ".build/tmux/tmux",
          "to": "tmux/tmux"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "packElevateHelper": false,
      "include": "scripts/installer.nsh"
    }
  },
  "pnpm": {
    "overrides": {
      "@peculiar/x509": "3.1.0",
      "@peculiar/asn1-android": "3.0.0",
      "@peculiar/asn1-asym-key": "3.0.0",
      "@peculiar/asn1-cms": "3.0.0",
      "@peculiar/asn1-csr": "3.0.0",
      "@peculiar/asn1-ecc": "3.0.0",
      "@peculiar/asn1-pfx": "3.0.0",
      "@peculiar/asn1-pkcs8": "3.0.0",
      "@peculiar/asn1-pkcs9": "3.0.0",
      "@peculiar/asn1-rsa": "3.0.0",
      "@peculiar/asn1-schema": "3.0.0",
      "@peculiar/asn1-x509": "3.0.0",
      "@peculiar/asn1-x509-attr": "3.0.0",
      "@peculiar/asn1-x509-post-quantum": "3.0.0"
    }
  }
}

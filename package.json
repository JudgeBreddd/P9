{
  "name": "p9",
  "version": "0.1.1",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "bin": {
    "p9": "scripts/p9.mjs"
  },
  "main": "apps/desktop/start.cjs",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "26.10.0"
  },
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "test":"node scripts/with-tmp.mjs node --test test/*.test.mjs",
    "test:capped": "node scripts/mem-guard.mjs && systemd-run --user --scope -q --unit=eh-tests-$$ -p MemoryMax=3G -p MemorySwapMax=0 node scripts/with-tmp.mjs node --test --test-concurrency=4 test/*.test.mjs",
    "gate:3": "node scripts/with-tmp.mjs node scripts/gate.mjs",
    "gate:all": "node scripts/with-tmp.mjs node scripts/gate.mjs --all",
    "scan": "node scripts/scan.mjs",
    "start": "node apps/server/main.mjs",
    "teh": "node scripts/teh.mjs",
    "build": "astro build --root apps/web && vite build --config apps/dev/vite.config.mjs",
    "check": "astro check --root apps/web",
    "desktop": "env -u ELECTRON_RUN_AS_NODE electron apps/desktop/start.cjs",
    "gate:4": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase4",
    "gate:5": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase5",
    "gate:6": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase6",
    "gate:7": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase7",
    "gate:8": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase8",
    "gate:9": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase9",
    "gate:10": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase10",
    "gate:11": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase11",
    "gate:12": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase12",
    "gate:13": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase13",
    "gate:15": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase15",
    "gate:16": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase16",
    "gate:17": "node scripts/with-tmp.mjs node scripts/gate.mjs --phase17",
    "build:dev": "vite build --config apps/dev/vite.config.mjs",
    "package:win": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.88.0",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@agentclientprotocol/sdk": "1.8.0",
    "@astrojs/react": "7.1.0",
    "@codingame/monaco-vscode-explorer-service-override": "33.0.9",
    "@hono/node-server": "2.1.4",
    "@simplewebauthn/server": "14.0.3",
    "@xterm/xterm": "6.1.0-beta.219",
    "astro": "7.4.0",
    "codemirror": "6.0.2",
    "hono": "4.13.13",
    "marked": "14.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@codingame/monaco-vscode-api": "33.0.9",
    "@codingame/monaco-vscode-authentication-service-override": "33.0.9",
    "@codingame/monaco-vscode-configuration-service-override": "33.0.9",
    "@codingame/monaco-vscode-debug-service-override": "33.0.9",
    "@codingame/monaco-vscode-editor-api": "33.0.9",
    "@codingame/monaco-vscode-environment-service-override": "33.0.9",
    "@codingame/monaco-vscode-extension-gallery-service-override": "33.0.9",
    "@codingame/monaco-vscode-extensions-service-override": "33.0.9",
    "@codingame/monaco-vscode-files-service-override": "33.0.9",
    "@codingame/monaco-vscode-keybindings-service-override": "33.0.9",
    "@codingame/monaco-vscode-languages-service-override": "33.0.9",
    "@codingame/monaco-vscode-model-service-override": "33.0.9",
    "@codingame/monaco-vscode-notifications-service-override": "33.0.9",
    "@codingame/monaco-vscode-output-service-override": "33.0.9",
    "@codingame/monaco-vscode-python-default-extension": "33.0.9",
    "@codingame/monaco-vscode-remote-agent-service-override": "33.0.9",
    "@codingame/monaco-vscode-scm-service-override": "33.0.9",
    "@codingame/monaco-vscode-search-service-override": "33.0.9",
    "@codingame/monaco-vscode-storage-service-override": "33.0.9",
    "@codingame/monaco-vscode-task-service-override": "33.0.9",
    "@codingame/monaco-vscode-terminal-service-override": "33.0.9",
    "@codingame/monaco-vscode-testing-service-override": "33.0.9",
    "@codingame/monaco-vscode-textmate-service-override": "33.0.9",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "33.0.9",
    "@codingame/monaco-vscode-theme-service-override": "33.0.9",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "33.0.9",
    "@codingame/monaco-vscode-workbench-service-override": "33.0.9",
    "@codingame/monaco-vscode-working-copy-service-override": "33.0.9",
    "@codingame/monaco-vscode-workspace-trust-service-override": "33.0.9",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@33.0.9"
  },
  "build": {
    "appId": "com.judgebreddd.p9",
    "productName": "P9 Event Horizon",
    "icon": "docs/brand/icon-primary-1024.png",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "apps/desktop/**",
      "apps/web/dist/**",
      "apps/dev/dist/**",
      "apps/server/child-env.mjs",
      "packages/protocol/**",
      "scripts/teh.mjs",
      "apps/server/process-tree.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/licenses",
        "to": "licenses"
      },
      {
        "from": ".build/node-win-x64/node.exe",
        "to": "daemon/node.exe"
      },
      {
        "from": "apps/server",
        "to": "daemon/apps/server"
      },
      {
        "from": "packages",
        "to": "daemon/packages"
      },
      {
        "from": ".build/daemon-deps/node_modules",
        "to": "daemon/node_modules"
      },
      {
        "from": "scripts/windows-host.ps1",
        "to": "daemon/scripts/windows-host.ps1"
      },
      {
        "from": "scripts/install-windows.ps1",
        "to": "daemon/scripts/install-windows.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "p9-event-horizon-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "packElevateHelper": false,
      "include": "scripts/installer.nsh"
    }
  },
  "pnpm": {
    "overrides": {
      "@peculiar/x509": "2.1.0",
      "@peculiar/asn1-android": "2.10.0",
      "@peculiar/asn1-asym-key": "2.10.0",
      "@peculiar/asn1-cms": "2.10.0",
      "@peculiar/asn1-csr": "2.10.0",
      "@peculiar/asn1-ecc": "2.10.0",
      "@peculiar/asn1-pfx": "2.10.0",
      "@peculiar/asn1-pkcs8": "2.10.0",
      "@peculiar/asn1-pkcs9": "2.10.0",
      "@peculiar/asn1-rsa": "2.10.0",
      "@peculiar/asn1-schema": "2.10.0",
      "@peculiar/asn1-x509": "2.10.0",
      "@peculiar/asn1-x509-attr": "2.10.0",
      "@peculiar/asn1-x509-post-quantum": "2.10.0"
    }
  }
}
